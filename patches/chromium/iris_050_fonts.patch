@@ -116,6 +120,55 @@ void SetDirectWriteFactory(IDWriteFactory* factory) {
 
 }  // anonymous namespace
 
+HRESULT PreflightIrisFontProfile(std::wstring* failing_family_name) {
+  if (failing_family_name) {
+    failing_family_name->clear();
+  }
+  Microsoft::WRL::ComPtr<IUnknown> factory_unknown;
+  HRESULT hr = DWriteCreateFactory(DWRITE_FACTORY_TYPE_SHARED,
+                                  __uuidof(IDWriteFactory), &factory_unknown);
+  if (FAILED(hr)) {
+    return hr;
+  }
+  Microsoft::WRL::ComPtr<IDWriteFactory> factory;
+  hr = factory_unknown.As(&factory);
+  if (FAILED(hr)) {
+    return hr;
+  }
+  Microsoft::WRL::ComPtr<IDWriteFontCollection> collection;
+  hr = factory->GetSystemFontCollection(&collection);
+  if (FAILED(hr)) {
+    return hr;
+  }
+
+  // 枚举身份并不保证每个名称都可作 local() 源；预检实际使用的泛型字体，
+  // 不再创建会改变 system-ui、字形回退和字体别名解析的裁剪集合。
+  constexpr std::array required_families{
+      iris::profile::kStandardFont, iris::profile::kSerifFont,
+      iris::profile::kSansSerifFont, iris::profile::kMonospaceFont,
+      iris::profile::kCursiveFont, iris::profile::kFantasyFont,
+      iris::profile::kMathFont};
+  for (size_t index = 0; index < iris::profile::kFontFamilies.size(); ++index) {
+    if (std::ranges::find(required_families,
+                          iris::profile::kFontFamilies[index]) ==
+        required_families.end()) {
+      continue;
+    }
+    const std::wstring_view family =
+        base::AsWStringView(iris::profile::kFontFamiliesUtf16[index]);
+    UINT32 family_index = 0;
+    BOOL exists = FALSE;
+    hr = collection->FindFamilyName(family.data(), &family_index, &exists);
+    if (FAILED(hr) || !exists) {
+      if (failing_family_name) {
+        *failing_family_name = family;
+      }
+      return FAILED(hr) ? hr : HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+    }
+  }
+  return S_OK;
+}
