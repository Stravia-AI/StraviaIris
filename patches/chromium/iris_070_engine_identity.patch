diff --git cef/libcef/common/iris_engine_exports.cc cef/libcef/common/iris_engine_exports.cc
new file mode 100644
index 0000000000000000000000000000000000000000..3cfc1cfb9958ac2b240506206c910853f4b71389
--- /dev/null
+++ cef/libcef/common/iris_engine_exports.cc
@@ -0,0 +1,46 @@
+// Copyright 2026 StraviaIris contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include "cef/libcef/common/iris_engine_exports.h"
+
+#include "base/functional/bind.h"
+#include "base/notreached.h"
+#include "components/iris/engine_build_id.h"
+#include "content/public/browser/devtools_server_start_observer.h"
+
+namespace {
+int32_t MapStartStatus(const content::DevToolsServerStartResult& result) {
+  if (result.started) {
+    return result.endpoint.address().IsLoopback()
+               ? iris_engine_debug_status_listening
+               : iris_engine_debug_status_endpoint_unverified;
+  }
+  switch (result.reason) {
+    case content::DevToolsServerStartResult::Reason::kSocketFailed:
+      return iris_engine_debug_status_bind_failed;
+    case content::DevToolsServerStartResult::Reason::kDisallowed:
+      return iris_engine_debug_status_disallowed;
+    case content::DevToolsServerStartResult::Reason::kServerThreadFailed:
+      return iris_engine_debug_status_server_thread_failed;
+  }
+  NOTREACHED();
+}
+}  // namespace
+
+const char* iris_engine_build_id(void) {
+  return iris::profile::kEngineBuildId;
+}
+
+void iris_engine_set_debugging_callback(
+    iris_engine_debugging_callback_t callback,
+    void* user_data) {
+  if (!callback) {
+    content::SetDevToolsServerStartObserver({});
+    return;
+  }
+  content::SetDevToolsServerStartObserver(base::BindRepeating(
+      [](iris_engine_debugging_callback_t notify, void* data,
+         const content::DevToolsServerStartResult& result) {
+        notify(MapStartStatus(result), result.net_error, result.endpoint.port(), data);
+      }, callback, user_data));
+}
diff --git cef/libcef/common/iris_engine_exports.h cef/libcef/common/iris_engine_exports.h
new file mode 100644
index 0000000000000000000000000000000000000000..f6290e00014785518483482f060cc74b808372f8
--- /dev/null
+++ cef/libcef/common/iris_engine_exports.h
@@ -0,0 +1,84 @@
+// Copyright 2026 StraviaIris contributors
+// SPDX-License-Identifier: BSD-3-Clause
+//
+// StraviaIris 私有引擎协议导出。本文件不属于 CEF 公共 API：CEF API hash、
+// 既有公共函数签名与导出集保持不变。字段与 ABI 严格对齐 SDK 侧
+// native/src/engine_protocol.h（iris_engine 命名空间中的函数指针类型）：
+//
+//   using BuildIdFunction = const char*(__cdecl*)();
+//   using DebuggingCallback = void(__cdecl*)(int32_t status,
+//                                            int32_t native_error,
+//                                            uint32_t port,
+//                                            void* user_data);
+//   using SetDebuggingCallbackFunction = void(__cdecl*)(DebuggingCallback,
+//                                                       void* user_data);
+//
+// iris_engine_build_id() 返回 components/iris/engine_build_id.h 中
+// iris::profile::kEngineBuildId（由构建从锁定源码+补丁队列+profile 生成，
+// 64 位小写十六进制 SHA-256，NUL 结尾，静态存储期）。SDK 用它在
+// CefInitialize 之前拒绝相同版本的原版 libcef。
+//
+// iris_engine_set_debugging_callback() 在 CefInitialize 之前注册、在
+// CefShutdown 之前注销（传空 callback 即注销）。回调在浏览器 UI 线程交付
+// 真实 DevTools HTTP 服务的启动结果，结果来自实际 socket owner（绑定/
+// 监听线程完成后的上报），不经日志、端口探测或初始化成功推断。
+
+#ifndef CEF_LIBCEF_COMMON_IRIS_ENGINE_EXPORTS_H_
+#define CEF_LIBCEF_COMMON_IRIS_ENGINE_EXPORTS_H_
+
+#include <stdint.h>
+
+#include "include/internal/cef_export.h"
+
+#if defined(COMPILER_MSVC)
+#define IRIS_ENGINE_CDECL __cdecl
+#else
+#define IRIS_ENGINE_CDECL
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// 调试端点回调。status 取下方 iris_engine_debug_status_* 之一：
+//   0 = 绑定成功且仅监听 loopback；port 为实际监听端口；
+//   非 0 = 失败，native_error 保留原始错误（负值 net::Error；无原始
+//   错误时为 0），port 为已知实际端口（未知为 0）。
+// 回调在 UI 线程同步调用，必须快速返回，且不得重入
+// iris_engine_set_debugging_callback。
+typedef void(IRIS_ENGINE_CDECL* iris_engine_debugging_callback_t)(
+    int32_t status,
+    int32_t native_error,
+    uint32_t port,
+    void* user_data);
+
+// 启动结果状态码。0 之外均为失败；SDK 契约只依赖 0/非 0。
+enum {
+  // 成功：HTTP 服务正在监听，且绑定端点已确认仅 loopback。
+  iris_engine_debug_status_listening = 0,
+  // 绑定失败：socket 创建/listen 失败；native_error 为原始 net::Error。
+  iris_engine_debug_status_bind_failed = 1,
+  // 在任何绑定尝试之前被策略/偏好拒绝；native_error 为 0。
+  iris_engine_debug_status_disallowed = 2,
+  // DevTools 服务线程未能启动，未发生绑定；native_error 为 0。
+  iris_engine_debug_status_server_thread_failed = 3,
+  // 正在监听但绑定端点未知或非 loopback，无法确认仅 loopback 监听；
+  // native_error 为读取本地地址失败时的原始 net::Error，否则为 0。
+  iris_engine_debug_status_endpoint_unverified = 4,
+};
+
+// 返回引擎 build ID（静态存储期的 NUL 结尾字符串）。
+CEF_EXPORT const char* iris_engine_build_id(void);
+
+// 注册/注销调试端点结果回调。user_data 原样透传。重复注册替换前一次
+// 注册；必须在 CefInitialize 前注册，UI 线程建立后只允许在该线程
+// 注册/注销。传空 callback 注销，返回后不会再访问旧 userdata。
+CEF_EXPORT void iris_engine_set_debugging_callback(
+    iris_engine_debugging_callback_t callback,
+    void* user_data);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // CEF_LIBCEF_COMMON_IRIS_ENGINE_EXPORTS_H_
