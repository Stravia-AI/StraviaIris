+// Copyright 2026 StraviaIris contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#ifndef COMPONENTS_IRIS_PROFILE_H_
+#define COMPONENTS_IRIS_PROFILE_H_
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+#include "components/iris/profile_data.h"
+
+namespace iris {
+
+struct RuntimeConfig {
+  uint64_t seed;
+  uint64_t canvas_seed;
+  std::string timezone;
+};
+
+// 仅供进程启动主线程调用，须先于 renderer/worker/GPU 工作线程。
+// 十进制 seed 必须完整且不溢出；0 合法。重复初始化失败，不改变既有配置。
+// timezone 的 ICU 校验由 ICU 初始化后的原有启动层完成。
+bool InitializeProcess(std::string_view seed, std::string_view timezone_id);
+
+// 成功 InitializeProcess 后才可访问；返回值在进程退出前不可变且保持有效。
+const RuntimeConfig& GetRuntimeConfig();
+
+// 显式时区可选；未初始化运行配置的构建工具没有 override。
+// 非空返回值借用进程生命周期内不可变的配置，不允许借此读取默认 seed。
+std::string_view GetTimezoneOverride();
+
+}  // namespace iris
+
+#endif  // COMPONENTS_IRIS_PROFILE_H_
