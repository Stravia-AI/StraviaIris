new file mode 100644
index 0000000000000000000000000000000000000000..4a02b902d0347bc1d0f7434193b0db6019e2249b
--- /dev/null
+++ components/iris/generate_engine_identity.py
@@ -0,0 +1,32 @@
+# Copyright 2026 StraviaIris contributors
+# SPDX-License-Identifier: BSD-3-Clause
+"""将构建驱动计算的输入摘要转成编译期常量，不参与其自身摘要。"""
+
+import argparse
+from pathlib import Path
+import re
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--input", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    build_id = args.input.read_text(encoding="ascii").strip()
+    if not re.fullmatch(r"[0-9a-f]{64}", build_id):
+        parser.error("engine build ID must be a lowercase SHA-256 digest")
+    content = (
+        "// Generated from the engine build input digest; do not edit.\n"
+        "#ifndef COMPONENTS_IRIS_ENGINE_BUILD_ID_H_\n"
+        "#define COMPONENTS_IRIS_ENGINE_BUILD_ID_H_\n\n"
+        "namespace iris::profile {\n"
+        f'inline constexpr char kEngineBuildId[] = "{build_id}";\n'
+        "}  // namespace iris::profile\n\n"
+        "#endif  // COMPONENTS_IRIS_ENGINE_BUILD_ID_H_\n"
+    )
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(content, encoding="utf-8", newline="\n")
+
+
+if __name__ == "__main__":
+    main()
diff --git components/iris/generate_profile.py components/iris/generate_profile.py
new file mode 100644
index 0000000000000000000000000000000000000000..4b07bfd1f4266076fbeceaaa11e22d854db33bcf
--- /dev/null
+++ components/iris/generate_profile.py
@@ -0,0 +1,190 @@
+# Copyright 2026 StraviaIris contributors
+# SPDX-License-Identifier: BSD-3-Clause
+"""从唯一 profile 和已核实的 Chromium VERSION 生成原生常量。"""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+
+STRINGS = {
+    "id": "kId",
+    "platform": "kPlatform",
+    "user_agent.platform": "kUaPlatform",
+    "user_agent.platform_version": "kUaPlatformVersion",
+    "user_agent.architecture": "kUaArchitecture",
+    "user_agent.bitness": "kUaBitness",
+    "screen.orientation": "kScreenOrientation",
+    "webgl.vendor": "kWebGlVendor",
+    "webgl.renderer": "kWebGlRenderer",
+    "webgpu.vendor": "kWebGpuVendor",
+    "webgpu.architecture": "kWebGpuArchitecture",
+    "webgpu.device": "kWebGpuDevice",
+    "webgpu.description": "kWebGpuDescription",
+    "connection.effective_type": "kConnectionEffectiveType",
+    "generic_fonts.standard": "kStandardFont",
+    "generic_fonts.serif": "kSerifFont",
+    "generic_fonts.sans_serif": "kSansSerifFont",
+    "generic_fonts.monospace": "kMonospaceFont",
+    "generic_fonts.cursive": "kCursiveFont",
+    "generic_fonts.fantasy": "kFantasyFont",
+    "generic_fonts.math": "kMathFont",
+}
+INTEGERS = {
+    "profile_version": "kProfileVersion",
+    "hardware_concurrency": "kHardwareConcurrency",
+    "device_memory": "kDeviceMemory",
+    "device_memory_header": "kDeviceMemoryHeader",
+    "max_touch_points": "kMaxTouchPoints",
+    "connection.rtt_ms": "kConnectionRttMs",
+    "screen.width": "kScreenWidth",
+    "screen.height": "kScreenHeight",
+    "screen.available_width": "kAvailableWidth",
+    "screen.available_height": "kAvailableHeight",
+    "screen.color_depth": "kColorDepth",
+    "screen.pixel_depth": "kPixelDepth",
+    "screen.depth_per_component": "kDepthPerComponent",
+    "screen.viewport_width": "kViewportWidth",
+    "screen.viewport_height": "kViewportHeight",
+    "screen.inner_width": "kInnerWidth",
+    "screen.inner_height": "kInnerHeight",
+    "screen.outer_width": "kOuterWidth",
+    "screen.outer_height": "kOuterHeight",
+    "audio_sample_rate": "kAudioSampleRate",
+}
+INT64S = {
+    "storage_quota": "kStorageQuota",
+}
+DOUBLES = {
+    "connection.downlink_mbps": "kConnectionDownlinkMbps",
+}
+BOOLEANS = {"user_agent.mobile": "kMobile", "user_agent.wow64": "kWow64",
+            "prefers_reduced_motion": "kPrefersReducedMotion",
+            "connection.save_data": "kConnectionSaveData"}
+ARRAYS = {"languages": "kLanguages", "fonts": "kFontFamilies",
+          "webgpu.features": "kWebGpuFeatures"}
+
+
+def value_at(data, key):
+    value = data
+    for part in key.split("."):
+        value = value[part]
+    return value
+
+
+def literal(value, *, allow_empty=False):
+    if not isinstance(value, str) or (not value and not allow_empty) or "\0" in value:
+        raise ValueError("profile 字符串无效：禁止 NUL，仅可选 GPU 信息允许为空")
+    # JSON 和 C++ 对当前 profile 所用字符采用相同的字面量转义。
+    if not value.isascii():
+        raise ValueError("当前 Windows desktop profile 使用 ASCII 身份和字体名称")
+    return json.dumps(value, ensure_ascii=True)
+
+
+def generate(profile, lock, version_text):
+    expected = set(STRINGS) | set(INTEGERS) | set(INT64S) | set(DOUBLES) | set(BOOLEANS) | set(ARRAYS)
+    expected |= {"schema_version", "screen.device_scale_factor"}
+
+    def leaves(value, prefix=""):
+        for key, child in value.items():
+            path = f"{prefix}.{key}" if prefix else key
+            if isinstance(child, dict):
+                yield from leaves(child, path)
+            else:
+                yield path
+
+    if set(leaves(profile)) != expected:
+        raise ValueError("profile 字段与唯一原生 schema 不一致")
+    if (type(profile["schema_version"]) is not int or
+            profile["schema_version"] != 1 or
+            profile["id"] != "windows-desktop"):
+        raise ValueError("不支持的 profile schema 或 ID")
+    version = dict(line.split("=", 1) for line in version_text.splitlines() if line)
+    parts = [version[key] for key in ("MAJOR", "MINOR", "BUILD", "PATCH")]
+    if not all(part.isascii() and part.isdecimal() for part in parts):
+        raise ValueError("Chromium VERSION 不是四段十进制版本")
+    full_version = ".".join(parts)
+    if lock["chromium"]["tag"] != f"refs/tags/{full_version}":
+        raise ValueError("Chromium VERSION 与锁定版本不一致")
+    lines = [
+        "// 由 generate_profile.py 生成；修改唯一 profile JSON，不手工编辑。",
+        "#ifndef COMPONENTS_IRIS_PROFILE_DATA_H_",
+        "#define COMPONENTS_IRIS_PROFILE_DATA_H_",
+        "#include <array>",
+        "#include <cstdint>",
+        "#include <string_view>",
+        "namespace iris::profile {",
+        f"inline constexpr std::string_view kFullVersion = {literal(full_version)};",
+        f"inline constexpr int kMajorVersion = {int(parts[0])};",
+    ]
+    for key, name in STRINGS.items():
+        # GPUAdapterInfo 允许不公开这些可选标识，不能用宿主信息填补。
+        allow_empty = key in {"webgpu.architecture", "webgpu.device", "webgpu.description"}
+        value = literal(value_at(profile, key), allow_empty=allow_empty)
+        lines.append(f"inline constexpr std::string_view {name} = {value};")
+    for key, name in INTEGERS.items():
+        value = value_at(profile, key)
+        if type(value) is not int or not 0 <= value <= 0x7fffffff:
+            raise ValueError(f"{key} 不是非负 int32")
+        lines.append(f"inline constexpr int {name} = {value};")
+    for key, name in INT64S.items():
+        value = value_at(profile, key)
+        if type(value) is not int or not 0 <= value <= 0x7fffffffffffffff:
+            raise ValueError(f"{key} 不是非负 int64")
+        lines.append(f"inline constexpr std::int64_t {name} = {value};")
+    for key, name in DOUBLES.items():
+        value = value_at(profile, key)
+        if type(value) not in (int, float) or not 0 <= float(value) <= 1e308:
+            raise ValueError(f"{key} 不是非负 double")
+        lines.append(f"inline constexpr double {name} = {float(value)!r};")
+    for key, name in BOOLEANS.items():
+        value = value_at(profile, key)
+        if type(value) is not bool:
+            raise ValueError(f"{key} 不是 bool")
+        lines.append(f"inline constexpr bool {name} = {str(value).lower()};")
+    for key, name in ARRAYS.items():
+        values = value_at(profile, key)
+        if not isinstance(values, list) or not values or len(values) != len(set(values)):
+            raise ValueError(f"{key} 不是非空且不重复的字符串数组")
+        elements = ", ".join(literal(value) for value in values)
+        lines.append(f"inline constexpr std::array<std::string_view, {len(values)}> {name} = {{{elements}}};")
+    fonts = profile["fonts"]
+    if any(font not in fonts for font in profile["generic_fonts"].values()):
+        raise ValueError("generic family 不在允许的实际字体集合内")
+    wide_fonts = ", ".join("u" + literal(font) for font in fonts)
+    lines.append(f"inline constexpr std::array<std::u16string_view, {len(fonts)}> kFontFamiliesUtf16 = {{{wide_fonts}}};")
+    languages = ",".join(profile["languages"])
+    lines.append(f"inline constexpr std::string_view kAcceptLanguage = {literal(languages)};")
+    scale = profile["screen"]["device_scale_factor"]
+    if type(scale) not in (int, float) or not 0 < scale <= 8:
+        raise ValueError("无效 device scale factor")
+    lines.append(f"inline constexpr double kDeviceScaleFactor = {float(scale)!r};")
+    screen = profile["screen"]
+    if not (0 < screen["available_width"] <= screen["width"] and
+            0 < screen["available_height"] <= screen["height"] and
+            all(screen[key] > 0 for key in (
+                "viewport_width", "viewport_height", "inner_width",
+                "inner_height", "outer_width", "outer_height"))):
+        raise ValueError("屏幕和 viewport 尺寸不一致")
+    if not 0 < screen["depth_per_component"] * 3 <= screen["color_depth"]:
+        raise ValueError("RGB 分量位深与总位深不一致")
+    lines += ["}  // namespace iris::profile", "#endif  // COMPONENTS_IRIS_PROFILE_DATA_H_", ""]
+    return "\n".join(lines)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    for option in ("profile", "lock", "version", "output"):
+        parser.add_argument(f"--{option}", type=Path, required=True)
+    args = parser.parse_args()
+    result = generate(json.loads(args.profile.read_text(encoding="utf-8")),
+                      json.loads(args.lock.read_text(encoding="utf-8")),
+                      args.version.read_text(encoding="utf-8"))
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    if not args.output.exists() or args.output.read_text(encoding="utf-8") != result:
+        args.output.write_text(result, encoding="utf-8", newline="\n")
+
+
+if __name__ == "__main__":
+    main()
diff --git components/iris/noise.h components/iris/noise.h
new file mode 100644
index 0000000000000000000000000000000000000000..ad790f1c54bc104bdd287f47161044645fcb19bd
--- /dev/null
+++ components/iris/noise.h
@@ -0,0 +1,36 @@
+// Copyright 2026 StraviaIris contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#ifndef COMPONENTS_IRIS_NOISE_H_
+#define COMPONENTS_IRIS_NOISE_H_
+
+#include <cstdint>
+
+namespace iris {
+
+constexpr uint64_t Mix64(uint64_t value) {
+  value = (value ^ (value >> 30)) * 0xbf58476d1ce4e5b9ULL;
+  value = (value ^ (value >> 27)) * 0x94d049bb133111ebULL;
+  return value ^ (value >> 31);
+}
+
+// 只依赖导出图像坐标，不依赖尺寸、内容或渲染上下文类型。
+constexpr uint32_t CanvasPixelHash(uint64_t seed, uint32_t x, uint32_t y) {
+  uint64_t value = seed ^ (uint64_t{x} * 0x517cc1b727220a95ULL) ^
+                   (uint64_t{y} * 0x6c62272e07bb0142ULL);
+  value = (value ^ (value >> 33)) * 0xff51afd7ed558ccdULL;
+  value = (value ^ (value >> 33)) * 0xc4ceb9fe1a85ec53ULL;
+  return static_cast<uint32_t>(value ^ (value >> 33));
+}
+
+inline uint32_t CanvasNoiseThreshold(uint64_t seed) {
+  const uint32_t folded = static_cast<uint32_t>(
+      seed ^ (seed >> 16) ^ (seed >> 32));
+  // 单精度舍入是参考阈值的一部分，不能改成整数近似或双精度。
+  return static_cast<uint32_t>(
+      (static_cast<float>(folded % 200) / 100000.0f + 0.003f) * 10000.0f);
+}
+
+}  // namespace iris
+
+#endif  // COMPONENTS_IRIS_NOISE_H_
diff --git components/iris/noise_unittest.cc components/iris/noise_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..bd5e5a99f6ab4372b4324480b28ef735a44e661c
--- /dev/null
+++ components/iris/noise_unittest.cc
@@ -0,0 +1,93 @@
+// Copyright 2026 StraviaIris contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include "components/iris/skia_pixels.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkImageInfo.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+
+namespace iris {
+namespace {
+
+constexpr int kWidth = 128;
+constexpr int kHeight = 5;
+constexpr size_t kRowBytes = kWidth * 4 + 16;
+constexpr uint64_t kReferenceCanvasSeed = 0xe1d12aa82badc1cfULL;
+using Pixels = std::array<uint8_t, kRowBytes * kHeight>;
+
+Pixels MakePixels(std::array<uint8_t, 4> color) {
+  Pixels pixels;
+  pixels.fill(0xa5);
+  for (int y = 0; y < kHeight; ++y) {
+    for (int x = 0; x < kWidth; ++x) {
+      std::copy(color.begin(), color.end(),
+                pixels.begin() + y * kRowBytes + x * 4);
+    }
+  }
+  return pixels;
+}
+
+TEST(IrisCanvasExportTest, MatchesReferencePixelsWithoutChangingRowPadding) {
+  auto pixels = MakePixels({101, 123, 147, 255});
+  auto expected = pixels;
+  // 来自独立运行的 Owl profile118/seed42 的完整 128×5 导出区域。
+  --expected[14 * 4 + 2];
+  ++expected[105 * 4];
+  --expected[2 * kRowBytes + 50 * 4 + 1];
+  ++expected[4 * kRowBytes + 42 * 4];
+  const SkPixmap pixmap(
+      SkImageInfo::Make(kWidth, kHeight, kRGBA_8888_SkColorType,
+                        kUnpremul_SkAlphaType),
+      pixels.data(), kRowBytes);
+  EXPECT_TRUE(PerturbSkPixmap(pixmap, kReferenceCanvasSeed));
+  EXPECT_EQ(pixels, expected);
+}
+
+TEST(IrisCanvasExportTest, BgraPreservesAlphaAndSkipsChannelOverflow) {
+  auto pixels = MakePixels({147, 123, 101, 255});
+  pixels[14 * 4] = 0;
+  pixels[105 * 4 + 2] = 255;
+  pixels[2 * kRowBytes + 50 * 4 + 3] = 254;
+  auto expected = pixels;
+  ++expected[4 * kRowBytes + 42 * 4 + 2];
+  const SkPixmap pixmap(
+      SkImageInfo::Make(kWidth, kHeight, kBGRA_8888_SkColorType,
+                        kUnpremul_SkAlphaType),
+      pixels.data(), kRowBytes);
+  EXPECT_TRUE(PerturbSkPixmap(pixmap, kReferenceCanvasSeed));
+  EXPECT_EQ(pixels, expected);
+}
+
+TEST(IrisCanvasExportTest, LeavesFloat16AndDisabledNoiseUnchanged) {
+  std::array<uint16_t, kWidth * kHeight * 4> halves;
+  for (size_t index = 0; index < halves.size(); index += 4) {
+    halves[index] = 0x3001;
+    halves[index + 1] = 0x3401;
+    halves[index + 2] = 0x3801;
+    halves[index + 3] = 0x3c00;
+  }
+  const auto expected_halves = halves;
+  const SkPixmap half_pixmap(
+      SkImageInfo::Make(kWidth, kHeight, kRGBA_F16_SkColorType,
+                        kUnpremul_SkAlphaType),
+      halves.data(), kWidth * 8);
+  EXPECT_FALSE(PerturbSkPixmap(half_pixmap, kReferenceCanvasSeed));
+  EXPECT_EQ(halves, expected_halves);
+
+  auto pixels = MakePixels({101, 123, 147, 255});
+  const auto expected_pixels = pixels;
+  const SkPixmap byte_pixmap(
+      SkImageInfo::Make(kWidth, kHeight, kRGBA_8888_SkColorType,
+                        kUnpremul_SkAlphaType),
+      pixels.data(), kRowBytes);
+  EXPECT_FALSE(PerturbSkPixmap(byte_pixmap, 0));
+  EXPECT_EQ(pixels, expected_pixels);
+}
+
+}  // namespace
+}  // namespace iris
