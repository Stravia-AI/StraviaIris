@@ -0,0 +1,58 @@
+// Copyright 2026 StraviaIris contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include "components/iris/skia_pixels.h"
+
+#include <bit>
+
+#include "components/iris/noise.h"
+#include "third_party/skia/include/core/SkImageInfo.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+
+namespace iris {
+
+bool PerturbSkPixmap(const SkPixmap& pixmap, uint64_t canvas_seed) {
+  static_assert(std::endian::native == std::endian::little);
+  if (canvas_seed == 0 || pixmap.width() <= 0 || pixmap.height() <= 0 ||
+      !pixmap.addr()) {
+    return false;
+  }
+  const SkColorType type = pixmap.colorType();
+  if (type != kRGBA_8888_SkColorType && type != kRGB_888x_SkColorType &&
+      type != kBGRA_8888_SkColorType) {
+    return false;
+  }
+  if (pixmap.rowBytes() < static_cast<size_t>(pixmap.width()) * 4 ||
+      SkImageInfo::ByteSizeOverflowed(pixmap.computeByteSize())) {
+    return false;
+  }
+
+  const uint32_t threshold = CanvasNoiseThreshold(canvas_seed);
+  bool changed = false;
+  for (int y = 0; y < pixmap.height(); ++y) {
+    auto* row = static_cast<uint8_t*>(pixmap.writable_addr(0, y));
+    for (int x = 0; x < pixmap.width(); ++x) {
+      uint8_t* pixel = row + static_cast<size_t>(x) * 4;
+      if (pixel[3] != 255) {
+        continue;
+      }
+      const uint32_t hash = CanvasPixelHash(canvas_seed, x, y);
+      if (hash % 10000 >= threshold) {
+        continue;
+      }
+      uint32_t channel = (hash >> 16) % 3;
+      if (type == kBGRA_8888_SkColorType) {
+        channel = 2 - channel;
+      }
+      const int value = pixel[channel] + ((hash & 0x100000) ? 1 : -1);
+      if (value < 0 || value > 255) {
+        continue;
+      }
+      pixel[channel] = static_cast<uint8_t>(value);
+      changed = true;
+    }
+  }
+  return changed;
+}
+
+}  // namespace iris
