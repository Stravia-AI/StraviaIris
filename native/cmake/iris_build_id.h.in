#ifndef STRAVIA_IRIS_IRIS_BUILD_ID_H_
#define STRAVIA_IRIS_IRIS_BUILD_ID_H_

#define IRIS_ENGINE_BUILD_ID "@IRIS_ENGINE_BUILD_ID@"

#endif  // STRAVIA_IRIS_IRIS_BUILD_ID_H_
