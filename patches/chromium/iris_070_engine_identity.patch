new file mode 100644
index 0000000000000000000000000000000000000000..5e05910f7a99f73f1d065213618d3c4c08b794ca
--- /dev/null
+++ content/browser/devtools/devtools_server_start_observer.cc
@@ -0,0 +1,33 @@
+// Copyright 2026 StraviaIris contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include "content/public/browser/devtools_server_start_observer.h"
+
+#include "base/check.h"
+#include "base/no_destructor.h"
+#include "content/public/browser/browser_thread.h"
+
+namespace content {
+namespace {
+DevToolsServerStartObserver& Observer() {
+  static base::NoDestructor<DevToolsServerStartObserver> observer;
+  return *observer;
+}
+}  // namespace
+
+void SetDevToolsServerStartObserver(DevToolsServerStartObserver observer) {
+  // SDK 在 CefInitialize 前注册，之后所有操作与通知均在浏览器 UI 线程。
+  // 不排队复制 callback；注销后不存在携带旧 userdata 的待执行任务。
+  CHECK(!BrowserThread::IsThreadInitialized(BrowserThread::UI) ||
+        BrowserThread::CurrentlyOn(BrowserThread::UI));
+  Observer() = std::move(observer);
+}
+
+void NotifyDevToolsServerStarted(const DevToolsServerStartResult& result) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (Observer()) {
+    Observer().Run(result);
+  }
+}
+
+}  // namespace content
