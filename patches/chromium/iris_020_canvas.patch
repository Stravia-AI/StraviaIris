+scoped_refptr<StaticBitmapImage> ImageDataBuffer::CreateCanvasSnapshot(
+    scoped_refptr<StaticBitmapImage> image) {
+  if (!image)
+    return nullptr;
+  const uint64_t canvas_seed = iris::GetRuntimeConfig().canvas_seed;
+  if (canvas_seed == 0)
+    return image;
+  const PaintImage paint_image = image->PaintImageForCurrentFrame();
+  if (!paint_image || paint_image.IsPaintWorklet())
+    return nullptr;
+  const SkColorType type = paint_image.GetColorType();
+  if (type != kRGBA_8888_SkColorType && type != kRGB_888x_SkColorType &&
+      type != kBGRA_8888_SkColorType)
+    return image;
+  ImageDataBuffer buffer(paint_image, canvas_seed);
+  if (!buffer.IsValid() || !buffer.retained_image_)
+    return nullptr;
+  auto snapshot = UnacceleratedStaticBitmapImage::Create(
+      std::move(buffer.retained_image_), image->Orientation(),
+      paint_image.GetHDRMetadata());
+  snapshot->SetOriginClean(image->OriginClean());
+  return snapshot;
+}
