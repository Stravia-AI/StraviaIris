diff --git content/public/browser/devtools_server_start_observer.h content/public/browser/devtools_server_start_observer.h
new file mode 100644
index 0000000000000000000000000000000000000000..10407b325115f35078073569672d2083f90d1f43
--- /dev/null
+++ content/public/browser/devtools_server_start_observer.h
@@ -0,0 +1,70 @@
+// Copyright 2026 StraviaIris contributors
+// SPDX-License-Identifier: BSD-3-Clause
+//
+// Process-wide observer for the remote debugging server start result.
+// The result is delivered on the UI thread by the actual socket owner
+// (DevToolsHttpHandler's server thread posts the outcome of the real
+// bind/listen attempt), so consumers never need to infer readiness from
+// log output, port polling, or browser-initialization success.
+
+#ifndef CONTENT_PUBLIC_BROWSER_DEVTOOLS_SERVER_START_OBSERVER_H_
+#define CONTENT_PUBLIC_BROWSER_DEVTOOLS_SERVER_START_OBSERVER_H_
+
+#include "base/functional/callback.h"
+#include "content/common/content_export.h"
+#include "net/base/ip_endpoint.h"
+#include "net/base/net_errors.h"
+
+namespace content {
+
+// Outcome of one remote debugging server start attempt.
+struct DevToolsServerStartResult {
+  enum class Reason {
+    // Server socket creation/listen (or local address lookup) failed.
+    // |net_error| carries the original net::Error code when available.
+    kSocketFailed,
+    // The start attempt was rejected by policy or preference before any
+    // socket was created. |net_error| is net::OK.
+    kDisallowed,
+    // The dedicated devtools server thread failed to start, so no bind
+    // attempt was made. |net_error| is net::OK.
+    kServerThreadFailed,
+  };
+
+  // True when the server socket was created and is listening. Note that a
+  // listening socket may still have an empty |endpoint| when the local
+  // address could not be read; consumers that must confirm the bound
+  // address need to check |endpoint| explicitly.
+  bool started = false;
+
+  Reason reason = Reason::kSocketFailed;
+
+  // Original net error code of the failed attempt (negative net::Error
+  // value), or net::OK when no underlying error is available. Never a
+  // fabricated status code.
+  int net_error = net::OK;
+
+  // Actual bound endpoint when known; empty otherwise.
+  net::IPEndPoint endpoint;
+};
+
+// Invoked on the UI thread with each start result. Must not call
+// SetDevToolsServerStartObserver() re-entrantly.
+using DevToolsServerStartObserver =
+    base::RepeatingCallback<void(const DevToolsServerStartResult&)>;
+
+// Register before browser initialization and before requesting server startup.
+// Once the UI thread exists, registration and unregistration must run on it.
+// An empty callback unregisters synchronously; no result or callback is cached.
+CONTENT_EXPORT void SetDevToolsServerStartObserver(
+    DevToolsServerStartObserver observer);
+
+// Called on the UI thread by the DevTools HTTP handler (and by the
+// embedder-side start request path when the attempt is rejected before a
+// socket exists) with the outcome of a start attempt.
+CONTENT_EXPORT void NotifyDevToolsServerStarted(
+    const DevToolsServerStartResult& result);
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_DEVTOOLS_SERVER_START_OBSERVER_H_
