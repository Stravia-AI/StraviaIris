index 0000000000000000000000000000000000000000..105940f899ee478ee58294369581acaacd8b6f2f
--- /dev/null
+++ components/iris/profile.cc
@@ -0,0 +1,75 @@
+// Copyright 2026 StraviaIris contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include "components/iris/profile.h"
+
+#include <charconv>
+#include <random>
+#include <system_error>
+
+#include "base/check.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "components/iris/noise.h"
+
+namespace iris {
+namespace {
+
+// 在线程启动前发布；之后没有写入，也不为逐像素计算引入原子同步。
+const RuntimeConfig* g_runtime_config = nullptr;
+
+uint64_t CanvasSeed(uint64_t seed) {
+  if (seed == 0) {
+    return 0;
+  }
+  std::mt19937_64 generator(seed);
+  const uint64_t context = generator();
+  // 参考使用固定的 ctx_%016llx 标识和非标准 FNV 偏移量。
+  // 直接折叠十六进制字符，避免构造字符串；仅在进程初始化时派生。
+  uint64_t hash = 0x14650fb0739d0383ULL;
+  for (char value : std::string_view("ctx_")) {
+    hash = (hash ^ value) * 0x100000001b3ULL;
+  }
+  constexpr char kHex[] = "0123456789abcdef";
+  for (int shift = 60; shift >= 0; shift -= 4) {
+    hash = (hash ^ kHex[(context >> shift) & 15]) * 0x100000001b3ULL;
+  }
+  hash ^= 20;
+  if (hash == 0) {
+    hash = 0xa5a5a5a5a5a5a5a5ULL;
+  }
+  return Mix64(hash + 0x9e3779b97f4a7c15ULL);
+}
+
+}  // namespace
+
+// 形参命名 timezone_id：glibc time.h 暴露全局 timezone，原名触发 -Wshadow。
+bool InitializeProcess(std::string_view seed, std::string_view timezone_id) {
+  if (g_runtime_config || seed.empty() ||
+      timezone_id.find('\0') != std::string_view::npos ||
+      !base::IsStringUTF8(timezone_id)) {
+    return false;
+  }
+  uint64_t parsed_seed = 0;
+  const auto [end, error] =
+      std::from_chars(seed.data(), seed.data() + seed.size(), parsed_seed, 10);
+  if (error != std::errc{} || end != seed.data() + seed.size()) {
+    return false;
+  }
+  static const base::NoDestructor<RuntimeConfig> config(parsed_seed,
+                                                        CanvasSeed(parsed_seed),
+                                                        std::string(timezone_id));
+  g_runtime_config = config.get();
+  return true;
+}
+
+const RuntimeConfig& GetRuntimeConfig() {
+  CHECK(g_runtime_config);
+  return *g_runtime_config;
+}
+
+std::string_view GetTimezoneOverride() {
+  return g_runtime_config ? g_runtime_config->timezone : std::string_view();
+}
+
+}  // namespace iris
