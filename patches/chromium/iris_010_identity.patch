+// Iris: 与参考引擎一致的媒体能力口径：
+// - MediaRecorder.isTypeSupported / MediaSource.isTypeSupported：
+//   已知媒体容器一律返回 true（忽略 codecs 参数），未知容器 false。
+// - HTMLMediaElement.canPlayType：未知容器 ""；已知容器 + codec 已确认
+//   → "probably"；已知容器但 codec 未确认 → "maybe"。
+namespace iris_caps {
+
+// 已知容器集合（实测参考引擎得出）：
+//   video/: mp4, webm, ogg, x-matroska, 3gpp
+//   audio/: mp4, mp3, mpeg, ogg, wav, webm, flac, aac, x-m4a
+inline bool IsKnownMediaContainer(const String& mime_type) {
+  const String mime = mime_type.DeprecatedLower();
+  const String::size_type slash = mime.find('/');
+  if (slash == String::npos)
+    return false;
+  const String type = mime.substr(0, slash);
+  const String sub = mime.substr(slash + 1);
+  if (type == "video") {
+    return sub == "mp4" || sub == "webm" || sub == "ogg" ||
+           sub == "x-matroska" || sub == "3gpp";
+  }
+  if (type == "audio") {
+    return sub == "mp4" || sub == "mp3" || sub == "mpeg" || sub == "ogg" ||
+           sub == "wav" || sub == "webm" || sub == "flac" || sub == "aac" ||
+           sub == "x-m4a";
+  }
+  return false;
+}
+
+// 单个 codec token 在给定容器中是否被确认（→ probably）。
+// 未确认集合：av01/av1、mp3、mp4v.*、ac-3、ec-3、dvhe、theora(非 ogg)、
+// wav 中除 "1"(PCM) 外的数字 token 等。
+inline bool IsConfirmedCodecToken(const String& container_sub,
+                                  const String& token) {
+  if (token == "theora")
+    return container_sub == "ogg";
+  if (token == "1")
+    return container_sub == "wav";
+  return token.starts_with("avc1") || token.starts_with("avc3") ||
+         token.starts_with("hev1") || token.starts_with("hvc1") ||
+         token == "vp8" || token == "vp9" || token.starts_with("vp09.") ||
+         token.starts_with("mp4a.") || token == "opus" || token == "vorbis" ||
+         token == "flac";
+}
+
+enum class CodecSupport {
+  kUnknownContainer,
+  kMaybe,
+  kConfirmed,
+};
+
+// HTMLMediaElement.canPlayType 的三级口径。
+inline CodecSupport MediaElementSupport(const String& mime_type,
+                                        const String& codecs) {
+  if (!IsKnownMediaContainer(mime_type))
+    return CodecSupport::kUnknownContainer;
+  const String mime = mime_type.DeprecatedLower();
+  const String::size_type slash = mime.find('/');
+  const String type = mime.substr(0, slash);
+  const String sub = mime.substr(slash + 1);
+
+  if (codecs.empty()) {
+    // 隐式 codec 容器：mpeg/mp3→mp3、flac→flac、aac→aac 已确认；
+    // 其余裸容器无隐含 codec → maybe。
+    const bool implicit_confirmed =
+        type == "audio" &&
+        (sub == "mpeg" || sub == "mp3" || sub == "flac" || sub == "aac");
+    return implicit_confirmed ? CodecSupport::kConfirmed
+                              : CodecSupport::kMaybe;
+  }
+
+  // 全部 codec token 均确认 → probably；任一未确认 → maybe。
+  Vector<String> tokens = codecs.Split(',');
+  bool saw_token = false;
+  for (const String& raw : tokens) {
+    const String token = raw.StripWhiteSpace();
+    if (token.empty())
+      continue;
+    saw_token = true;
+    if (!IsConfirmedCodecToken(sub, token))
+      return CodecSupport::kMaybe;
+  }
+  return saw_token ? CodecSupport::kConfirmed : CodecSupport::kMaybe;
+}
